# Port (HuggingFace Spaces requires 7860)
PORT=7860

# Optional: password-protect the entire GUI with HTTP Basic Auth
AUTH_PASSWORD=

# AI provider configuration (set these as Secrets in your HF Space settings)
AI_PROVIDER=          # anthropic | openai | deepseek | gemini | qwen | kimi | custom
AI_API_KEY=           # Your API key for the chosen provider
AI_MODEL=             # Optional — uses provider default if blank
AI_BASE_URL=          # Only needed if AI_PROVIDER=custom
