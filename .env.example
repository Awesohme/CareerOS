# Port the server listens on (default: 4312)
PORT=4312

# Optional: password-protect the entire GUI with HTTP Basic Auth.
# Leave blank to disable auth (not recommended for public deployments).
AUTH_PASSWORD=

# Your Anthropic API key is stored in config/profile.yml after onboarding.
# You can also set it here as a fallback — but the UI setup wizard is preferred.
# ANTHROPIC_API_KEY=
